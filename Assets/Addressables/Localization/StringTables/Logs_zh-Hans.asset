  - m_Id: 39856761844862976
    m_Localized: "3. \u571F\u58E4\u68C0\u6D4B\u7ED3\u679C\u663E\u793A\uFF0C\u6574\u4E2A\u661F\u7403\u7684\u5730\u4E0B\u571F\u58E4\u4E2D\u904D\u5E03\u7740\u540C\u4E00\u751F\u7269\u4E2A\u4F53\u7684\u6709\u673A\u7EC4\u7EC7\uFF0C\u6B64\u5904\u6211\u4EEC\u79F0\u4E4B\u4E3A\u201C\u6839\u8109\u201D\u3002\u901A\u8FC7\u4E0E\u751F\u7269\u6837\u672C\u7684\u5BF9\u6BD4\u8868\u660E\uFF0C\u6B64\u661F\u7403\u4E2D\u7684\u6240\u6709\u751F\u7269\u90FD\u662F\u4ECE\u201C\u6839\u8109\u201D\u4E2D\u8BDE\u751F\uFF0C\u6B7B\u53BB\u7684\u751F\u7269\u6C89\u5165\u571F\u58E4\u540E\u4E5F\u4F1A\u7531\u201C\u6839\u8109\u201C\u5C06\u5176\u8F6C\u5316\u4E3A\u65B0\u751F\u4E2A\u4F53\u3002\n\r\n4.
      \u6839\u636E\u4E0D\u540C\u5730\u70B9\u7684\u571F\u58E4\u6837\u672C\u7684\u6D4B\u5E74\u7ED3\u679C\uFF0C\u4EE5\u53CA\u524D\u661F\u538625\u5E74\uFF08\u516C\u51432075\u5E74\uFF09-\u661F\u53860024\u5E74\u95F4\u7684\u89C2\u6D4B\u6570\u636E\uFF0C\u201C\u6839\u8109\u201C\u5F88\u53EF\u80FD\u53D1\u6E90\u4E8E\u661F\u7403\u7684\u4E2D\u5FC3\u706B\u5C71\uFF0C\u800C\u540E\u968F\u7740\u201D\u6839\u8109\u201C\u7684\u751F\u957F\uFF0C\u661F\u7403\u7684\u80FD\u6E90\u53D1\u751F\u4E86\u4ECE\u4E2D\u5FC3\u706B\u5C71\u5230\u6574\u4E2A\u661F\u7403\u7684\u6563\u5E03\uFF0C\u53EF\u4EE5\u786E\u5B9A\u7684\u662F\u5728\u79D1\u8003\u961F\u8FDB\u5165\u4E4B\u524D\uFF0C\u4E2D\u5FC3\u706B\u5C71\u5DF2\u7ECF\u5931\u53BB\u4E86\u6D3B\u6027\uFF0C\u65E0\u6CD5\u76F4\u63A5\u4ECE\u4E2D\u83B7\u5F97\u80FD\u6E90\u3002\n\r\n\u6839\u636E\u4EE5\u4E0A\u51E0\u70B9\u53EF\u4EE5\u5F97\u5230\u521D\u6B65\u63A8\u8BBA\uFF1A\u4EBA\u7C7B\u7684\u4ECB\u5165\u4F1A\u4EE5\u67D0\u79CD\u5F62\u5F0F\u5BF9\u8FD9\u4E2A\u5C01\u95ED\u7684\u751F\u6001\u7CFB\u7EDF\u4EA7\u751F\u5F71\u54CD\uFF0C\u4EBA\u7C7B\u7684\u5C38\u4F53\u88AB\u661F\u7403\u5438\u6536\u540E\u5F88\u53EF\u80FD\u4E5F\u4F1A\u53D1\u751F\u4E0E\u524D\u8FF0\u7C7B\u4F3C\u7684\u8F6C\u53D8\u3002
      \u6B64\u661F\u7403\u72EC\u7279\u7684\u751F\u6001\u5FAA\u73AF\u8FC7\u7A0B\u5177\u6709\u8F83\u9AD8\u7684\u7814\u7A76\u4EF7\u503C\u3002\n\nJean
      \xB7 Allgood\r\n\u661F\u53860025\u5E74101\u65E5"
